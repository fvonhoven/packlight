{
  "expo": {
    "name": "Packlight",
    "slug": "packlight",
    "scheme": "packlight",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fvonhoven.packlight"
